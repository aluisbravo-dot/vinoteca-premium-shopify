<div class="vp-contact-dock" aria-label="Contacto rápido">
<button class="vp-dock-button vp-chat-launch" type="button" aria-expanded="false" aria-controls="vp-assistant-panel">✦ Vinea</button>
<a class="vp-dock-button vp-dock-phone" href="tel:{{ settings.phone | remove: ' ' }}" aria-label="Llamar">☎</a>
<a class="vp-dock-button vp-dock-mail" href="mailto:{{ settings.email }}" aria-label="Correo">✉</a>
<a class="vp-dock-button vp-dock-wa" href="{{ settings.whatsapp | default: 'https://wa.me/51929184435?text=Hola%2C%20Vinoteca%20Premium.%20Deseo%20hacer%20una%20consulta.' }}" target="_blank" rel="noopener noreferrer" aria-label="Escribir por WhatsApp" title="Escribir por WhatsApp">WhatsApp</a>
</div>
<section class="vp-assistant" id="vp-assistant-panel" aria-label="Asistente Vinea" hidden>
<header class="vp-assistant-head"><div class="vp-assistant-avatar">V</div><div><strong>Vinea · Asistente virtual</strong><small>Disponible para orientarte</small></div><button class="vp-assistant-close" type="button" aria-label="Cerrar">×</button></header>
<div class="vp-assistant-messages" aria-live="polite"><div class="vp-chat-message vp-chat-bot">¡Hola! Soy Vinea, tu asistente virtual. Puedo explicarte Vinoteca Premium, sus secciones, variedades, maridajes y cómo contactar al equipo. ¿Qué te gustaría conocer?</div></div>
<div class="vp-assistant-quick"><button type="button" data-vp-question="¿Qué es Vinoteca Premium?">¿Qué es este sitio?</button><button type="button" data-vp-question="Explícame las secciones de la página">Secciones</button><button type="button" data-vp-question="¿Cómo contacto al equipo?">Contacto</button></div>
<form class="vp-assistant-form"><input name="question" maxlength="500" placeholder="Escribe tu consulta..." aria-label="Consulta" required><button type="submit" aria-label="Enviar">➤</button></form>
<div class="vp-assistant-tools"><button type="button" class="vp-voice-toggle" aria-pressed="false">♫ Escuchar respuestas</button><button type="button" class="vp-mic-button">● Dictar</button><span>Voz del navegador</span></div><div class="vp-assistant-foot">Asistente informativo · No procesa pedidos ni pagos.</div>
</section>