<section class="vp-section vp-wrap"><p class="vp-eyebrow">VINOTECA PREMIUM</p><h1>Tu carrito</h1>{% if cart.item_count == 0 %}<p>Tu carrito está vacío por ahora.</p><a class="vp-btn" href="{{ routes.all_products_collection_url }}">Explorar catálogo</a>{% else %}<form action="{{ routes.cart_url }}" method="post"><div class="vp-cart-items">{% for item in cart.items %}<div class="vp-cart-row">{% if item.image %}<img src="{{ item.image | image_url: width: 180 }}" alt="{{ item.title | escape }}">{% endif %}<div><a href="{{ item.url }}">{{ item.product.title }}</a><p>{{ item.final_price | money }}</p><label for="updates_{{ item.key }}">Cantidad</label><input id="updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><p class="vp-cart-total">Subtotal: <strong>{{ cart.total_price | money }}</strong></p><button class="vp-btn" type="submit" name="update">Actualizar carrito</button><button class="vp-btn" type="submit" name="checkout">Continuar al pago</button></form>{% endif %}</section>{% schema %}{"name":"Carrito","settings":[]}{% endschema %}