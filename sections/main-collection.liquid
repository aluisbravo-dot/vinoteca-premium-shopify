<section class="vp-section vp-wrap"><p class="vp-eyebrow">VINOTECA PREMIUM</p><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<div class="vp-lead">{{ collection.description }}</div>{% endif %}<div class="vp-products">{% paginate collection.products by 12 %}{% for product in collection.products %}<article class="vp-product"><a href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}<h3>{{ product.title }}</h3></a><p>{{ product.price | money }}</p></article>{% endfor %}{{ paginate | default_pagination }}{% endpaginate %}</div></section>{% schema %}{"name":"Colección","settings":[]}{% endschema %}