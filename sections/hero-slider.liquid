<section class="vp-hero" data-vp-hero>
{% assign slide_count = 0 %}
{% for block in section.blocks %}
{% assign hero_fallback = 'hero-vino-pour.jpg' %}
{% case forloop.index %}
{% when 2 %}{% assign hero_fallback = 'hero-vinedo-atardecer.jpg' %}
{% when 3 %}{% assign hero_fallback = 'hero-bodega-barricas.jpg' %}
{% when 4 %}{% assign hero_fallback = 'hero-brindis.jpg' %}
{% endcase %}
<div class="vp-hero-slide{% if slide_count == 0 %} is-active{% endif %}" {{ block.shopify_attributes }}>
{% if block.settings.image %}<img class="vp-hero-image" src="{{ block.settings.image | image_url: width: 2200 }}" alt="{{ block.settings.image.alt | escape }}" loading="{% if slide_count == 0 %}eager{% else %}lazy{% endif %}">{% else %}<img class="vp-hero-image" src="{{ hero_fallback | asset_url }}" alt="Fotografía de Vinoteca Premium">{% endif %}
<div class="vp-hero-shade"></div><div class="vp-wrap vp-hero-copy"><p class="vp-eyebrow">{{ block.settings.eyebrow }}</p><h1>{{ block.settings.title }}</h1><p>{{ block.settings.text }}</p><div class="vp-actions"><a class="vp-btn" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>{% if settings.whatsapp %}<a class="vp-btn vp-btn-outline" href="{{ settings.whatsapp }}" target="_blank" rel="noopener">Consultar por WhatsApp</a>{% endif %}</div></div>
</div>{% assign slide_count = slide_count | plus: 1 %}{% endfor %}
</section>
{% schema %}{"name":"Banner principal","settings":[{"type":"range","id":"interval","label":"Tiempo entre imágenes (segundos)","min":3,"max":12,"step":1,"default":6}],"blocks":[{"type":"slide","name":"Diapositiva","settings":[{"type":"image_picker","id":"image","label":"Fotografía"},{"type":"text","id":"eyebrow","label":"Texto pequeño","default":"VINOTECA PREMIUM · SELECCIÓN · ORIGEN"},{"type":"text","id":"title","label":"Título","default":"El arte de descubrir un buen vino."},{"type":"textarea","id":"text","label":"Descripción","default":"Explora variedades y descubre aromas, regiones y momentos que hacen especial cada botella."},{"type":"text","id":"button_label","label":"Texto del botón","default":"Explorar catálogo"},{"type":"url","id":"button_link","label":"Enlace del botón"}]}],"presets":[{"name":"Banner principal","blocks":[{"type":"slide"},{"type":"slide","settings":{"eyebrow":"VINOTECA PREMIUM · CULTURA VINÍCOLA","title":"El origen también se disfruta.","text":"Recorre paisajes de viñedos y conoce la tradición que acompaña cada variedad."}},{"type":"slide","settings":{"eyebrow":"VINOTECA PREMIUM · TRADICIÓN","title":"Tiempo, madera y carácter.","text":"Descubre el encanto de las bodegas y las barricas."}},{"type":"slide","settings":{"eyebrow":"VINOTECA PREMIUM · EXPERIENCIAS","title":"Cada encuentro merece un brindis.","text":"Una selección para compartir, aprender y disfrutar con responsabilidad."}}]}]}{% endschema %}