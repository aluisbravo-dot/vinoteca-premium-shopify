<section class="vp-section vp-wrap"><div class="vp-campaign"><img src="{{ 'campana-especial-calidad-vinoteca.jpg' | asset_url }}" alt="Campaña Vinoteca Premium: Esto sí es calidad, esto es un buen vino" loading="lazy"><div><p class="vp-eyebrow">CAMPAÑA ESPECIAL · VINOTECA PREMIUM</p><h2>{{ section.settings.title }}</h2><p>{{ section.settings.text }}</p><a class="vp-btn" href="{{ section.settings.link | default: '/pages/promociones' }}">{{ section.settings.button }}</a></div></div></section>
{% schema %}{"name":"Campaña especial","settings":[{"type":"text","id":"title","label":"Título","default":"Esto sí es calidad."},{"type":"textarea","id":"text","label":"Descripción","default":"Una pieza visual especial para celebrar el gusto por descubrir y compartir un buen vino."},{"type":"text","id":"button","label":"Botón","default":"Ver promociones"},{"type":"url","id":"link","label":"Enlace"}],"presets":[{"name":"Campaña especial"}]}{% endschema %}