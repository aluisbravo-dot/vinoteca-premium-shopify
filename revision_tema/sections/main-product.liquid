<section class="vp-section vp-wrap vp-product-detail"><div>{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1100 }}" alt="{{ product.title | escape }}">{% endif %}</div><div><p class="vp-eyebrow">VINOTECA PREMIUM · SELECCIÓN</p><h1>{{ product.title }}</h1><p class="vp-price">{{ product.selected_or_first_available_variant.price | money }}</p>{{ product.description }}{% form 'product', product %}{% if product.has_only_default_variant == false %}<label for="VariantSelect">Presentación</label><select id="VariantSelect" name="id">{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }} · {{ variant.price | money }}</option>{% endfor %}</select>{% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}<label for="Quantity">Cantidad</label><input id="Quantity" type="number" name="quantity" value="1" min="1"><button class="vp-btn" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Añadir al carrito{% else %}Agotado{% endif %}</button>{% endform %}</div></section>{% schema %}{"name":"Producto","settings":[]}{% endschema %}