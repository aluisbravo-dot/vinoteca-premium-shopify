<section class="vp-section vp-section-cream"><div class="vp-wrap"><p class="vp-eyebrow">CATÁLOGO VINOTECA PREMIUM</p><h2>{{ section.settings.title }}</h2><div class="vp-products">{% assign chosen = section.settings.collection %}{% if chosen != blank and chosen.products_count > 0 %}{% for product in chosen.products limit: section.settings.limit %}<article class="vp-product"><a href="{{ product.url }}">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">{% endif %}<h3>{{ product.title }}</h3></a><p>{{ product.price | money }}</p><a class="vp-text-link" href="{{ product.url }}">Ver producto →</a></article>{% endfor %}{% else %}<p>Conecta una colección desde los ajustes de esta sección para mostrar tus productos de Shopify.</p>{% endif %}</div><a class="vp-btn" href="{{ routes.all_products_collection_url }}">Ver catálogo completo</a></div></section>
{% schema %}{"name":"Productos destacados","settings":[{"type":"text","id":"title","label":"Título","default":"Explora nuestra selección"},{"type":"collection","id":"collection","label":"Colección"},{"type":"range","id":"limit","label":"Cantidad de productos","min":2,"max":8,"step":1,"default":4}],"presets":[{"name":"Productos destacados"}]}{% endschema %}