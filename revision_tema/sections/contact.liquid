<section class="vp-section vp-section-cream" id="contacto">
  <div class="vp-wrap vp-contact-layout">
    <div class="vp-contact-copy">
      <p class="vp-eyebrow">VINOTECA PREMIUM · CONTACTO</p>
      <h2>Conversemos sobre el mundo del vino</h2>
      <p>Déjanos tu consulta. Al enviar, se abrirá WhatsApp con tu mensaje listo para enviar a nuestro equipo.</p>
      <p><strong>Ubicación:</strong> Al costado del IESTP Manuel Seoane Corrales, San Juan de Lurigancho, Lima, Perú.</p>
      <p><strong>Teléfono:</strong> +51 929 184 435</p>
      <div class="vp-socials">
        {% if settings.facebook != blank %}<a class="vp-social-icon" href="{{ settings.facebook }}" target="_blank" rel="noopener" aria-label="Facebook">f</a>{% endif %}
        {% if settings.instagram != blank %}<a class="vp-social-icon" href="{{ settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">◎</a>{% endif %}
        {% if settings.tiktok != blank %}<a class="vp-social-icon" href="{{ settings.tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">♪</a>{% endif %}
      </div>
    </div>
    <form class="vp-contact-form" data-vp-whatsapp-form data-wa-number="51929184435">
      <label for="vp-shop-name">Nombre</label><input id="vp-shop-name" name="name" type="text" required maxlength="100" placeholder="Tu nombre">
      <label for="vp-shop-email">Correo electrónico</label><input id="vp-shop-email" name="email" type="email" required maxlength="150" placeholder="tu@correo.com">
      <label for="vp-shop-subject">Asunto</label><input id="vp-shop-subject" name="subject" type="text" required maxlength="150" placeholder="Motivo de tu consulta">
      <label for="vp-shop-message">Mensaje</label><textarea id="vp-shop-message" name="message" required maxlength="2000" rows="5" placeholder="Escribe tu consulta..."></textarea>
      <button class="vp-btn" type="submit">Enviar por WhatsApp</button>
      <p class="vp-form-note">WhatsApp se abrirá para que confirmes el envío. El mensaje no se envía automáticamente.</p>
    </form>
  </div>
</section>
{% schema %}{"name":"Contacto WhatsApp","settings":[]}{% endschema %}
